# Copy to .env and use credentials for a test NextDNS profile.
CLIENT_ID=your_test_profile_id
AUTH_SECRET=your_nextdns_api_key

# Comma-separated hosts-file URLs.
BLOCK=
REDIRECT=https://raw.githubusercontent.com/Internet-Helper/GeoHideDNS/refs/heads/main/hosts/hosts

# Comma-separated domains or patterns to prioritize.
REQUIRED_REDIRECT=*.openai.*,*.chatgpt.com
EXCLUDE_REDIRECT=
